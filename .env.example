PUBLIC_API_BASE_URL=

# Optional. Merkle proof-store URL for claimable rewards display.
# Set this to enable the "Unclaimed Rewards" display on /portfolio.
# Empty/unset → claimable shows as "—"; balances still render.
PUBLIC_PROOF_STORE_URL=

# Optional — overrides per-cluster default from @areal/sdk/network
# (HISTORY_API_BASE_URLS) for the history backend. Use this when running
# against a non-default deployment (staging, local indexer, etc.).
# WARNING: must be https:// in production deployments. Plain http://
# is only acceptable for localhost / dev — production builds will warn.
PUBLIC_HISTORY_API_URL=
